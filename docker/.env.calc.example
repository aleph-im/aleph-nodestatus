# === Calculation service env (nodestatus-calc) ===
#
# This key signs hourly nodestatus snapshots AND the hourly credit-calculation
# post (status='calculation'). It NEVER signs distributions. Use the status_sender
# key for this file; it does not need to hold any ALEPH.

ethereum_pkey=<status_sender_private_key>
ethereum_api_server=<your eth rpc>

# Aleph channel for the published calculation/distribution posts. The
# default in settings.py (`TEST`) is intentionally a sandbox; production
# deployments must override to the channel consumers subscribe to.
# Mirrors the channel used by the legacy staking-rewards-distribution.
aleph_channel=FOUNDATION

# Snapshot publishers accepted by the calculation. The default in settings.py
# includes the current publisher and the previous one for the rotation window.
# Remove the old address after a corrected distribution has moved the cursor
# past the period covered by the old publisher.
# snapshot_senders=["0xF45f6F13BF2A2Eb6Afa83FCC9e530DcF238b5D74", "0xa1B3bb7d2332383D96b7796B908fB7f7F3c2Be10"]

# All other settings inherit pydantic defaults. Add overrides below as needed
# for non-mainnet or non-default deployments.
